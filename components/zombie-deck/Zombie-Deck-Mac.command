#!/bin/sh
# Zombie-Deck is for Linux handhelds (Bazzite / Nobara). Nothing to install on a Mac.
cd "$(dirname "$0")" || exit 1
echo "Zombie-Deck fixes sleep and hibernation on Linux handhelds (ROG Ally, Steam Deck).";
echo "There is nothing to install on a Mac. Copy this folder to the handheld and run Zombie-Deck-Linux.sh there."
echo; echo "Press Enter to close"; read x
